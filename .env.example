# Copia este archivo como .env y pon tus propios valores:
#   cp .env.example .env
#
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Este .env.example sí se sube, para que cualquiera sepa qué
# variables necesita el proyecto.

# --- Credenciales de PostgreSQL ---
POSTGRES_USER=usuario_app
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=semana3

# --- Puerto en el que verás la API desde tu navegador ---
API_PORT=5000
